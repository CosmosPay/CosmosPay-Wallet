---
// Where the community server's callback sends the browser after a sign-in started in the web
// build (`returnTo`, listed in the server's WALLET_AUTH_RETURN_URLS). It hands an Authentik
// email sign-in's device binding to the wallet's own tab and closes — see
// src/app/SignInReturn.tsx and src/lib/signInBinding.ts. Nothing else of the wallet loads here.
import SignInReturn from '@/app/SignInReturn.tsx';
import '@/styles/theme.css';
import '@/styles/base.css';
import '@/styles/animations.css';
import '@/styles/app/sign-in-return.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark light" />
    <!-- The binding rides in the fragment, which no request carries; no referrer either. -->
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex" />
    <script is:inline src={`${import.meta.env.BASE_URL}theme-boot.js`}></script>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>Cosmos Wallet</title>
  </head>
  <body>
    <SignInReturn client:only="react" />
  </body>
</html>

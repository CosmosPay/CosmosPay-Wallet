---
// Dapp approval window (chrome-extension://…/approve/index.html?req=<id>). The service
// worker opens it when a site calls window.cosmosWallet.* and the user has to weigh in.
// Its own lightweight page (system font, no effects) so it drags in neither the popup's
// crash nor the full store.
import ApprovePopup from '@/components/ApprovePopup.tsx';
// Document chrome for this window. Kept out of the page as a stylesheet because
// Astro scopes a <style> block's element selectors to [data-astro-cid-…], and
// that attribute never reaches a client:only island's DOM.
import '@/styles/approve.css';
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <!-- Same as index.astro: the Node globals must exist before the island mounts. -->

    <script>
      import '@/lib/node-globals';
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>Cosmos Wallet · Aprobar</title>
  </head>
  <body>
    <ApprovePopup client:only="react" />
  </body>
</html>

---
import WalletApp from '@/app/WalletApp.tsx';
// Global stylesheets, in cascade order. Nothing is styled from this file:
// tokens, resets, keyframes and utilities all live under src/styles/.
import '@/styles/theme.css';
import '@/styles/base.css';
import '@/styles/animations.css';
import '@/styles/app.css';
---

<!doctype html>
<html lang="es">
  <head>
    <!-- Node globals (Buffer/global/process) expected by @stellar/js-xdr and bip39.
         Goes first: Astro hoists page scripts into the head and modules run in document
         order, so this lands before any island hydrates. -->
    <script>
      import '@/lib/nodeGlobals';
    </script>
    <meta charset="utf-8" />
    <!-- interactive-widget=resizes-content makes the on-screen keyboard shrink the
         LAYOUT viewport, so `100dvh` — and the shell frame with it — ends at the top of
         the keys the way the Android WebView already does. The default (resizes-visual)
         leaves the frame full height with its footer behind the keyboard; src/lib/viewport.ts
         covers that case anyway, for iOS, which ignores this key. -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}icons/icon-192.png`} />
    <!-- Installable web app: the manifest, and the iOS equivalents Safari still reads
         instead of it. The worker it pairs with is registered by src/lib/pwa.ts. -->
    <link rel="manifest" href={`${import.meta.env.BASE_URL}manifest.webmanifest`} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Cosmos Pay" />
    <meta
      name="description"
      content="Cosmos Pay — non-custodial multichain wallet. One recovery phrase for Stellar, Bitcoin, Ethereum, Solana, Arbitrum, Base and Monad: send, receive and swap across all of them, with a fiat on/off-ramp. Your keys never leave your device."
    />
    <meta name="application-name" content="Cosmos Pay" />
    <title>Cosmos Pay · Wallet</title>
  </head>
  <body>
    <WalletApp client:only="react" />
  </body>
</html>

<?xml version="1.0" encoding="utf-8"?>
<!-- Cosmos Pay brand logo — adaptive icon foreground (108dp canvas).
     A white crescent-planet motif on a transparent background, sized to fit
     the 72dp safe zone (14dp inset on each side). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Planet body: white circle, 54dp centred, 36dp radius = 72dp visible -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,54m-18,0a18,18 0,1 1,36 0a18,18 0,1 1,-36 0"/>
    <!-- Crescent cutout (dark inner arc) -->
    <path
        android:fillColor="#080808"
        android:pathData="M54,36a18,18 0,0 1,0 36a12,12 0,0 0,0 -36z"/>
    <!-- Ring arc: a thin tilted ellipse arc sweeping around the planet -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.35"
        android:pathData="M34,48c-4,6 -4,14 0,20c2,3 6,5 10,5c-4,-2 -8,-6 -10,-11c-2,-5 -2,-12 0,-18c2,-6 6,-10 10,-12c-4,0 -8,2 -10,6z"/>
    <!-- Star dot 1 (top-right) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M72,38m-1.5,0a1.5,1.5 0,1 1,3 0a1.5,1.5 0,1 1,-3 0"/>
    <!-- Star dot 2 (far right) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M75,48m-1,0a1,1 0,1 1,2 0a1,1 0,1 1,-2 0"/>
    <!-- Star dot 3 (top-left) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,38m-1,0a1,1 0,1 1,2 0a1,1 0,1 1,-2 0"/>
</vector>

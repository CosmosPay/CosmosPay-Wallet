{
  "name": "cosmos-stellar-wallet",
  "version": "1.2.5",
  "private": true,
  "type": "module",
  "description": "Cosmos — a non-custodial Stellar wallet (Astro + Preact + Capacitor)",
  "scripts": {
    "postinstall": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/patch-native-biometric.ts",
    "dev": "astro dev --host",
    "dev:android": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/cap-dev.ts android",
    "dev:ios": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/cap-dev.ts ios",
    "pair:android": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/adb-pair.ts",
    "android:icons": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/android-icons.ts",
    "android:res": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/android-res.ts",
    "native:perms": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/native-permissions.ts",
    "capacitor:sync:after": "npm run android:res && npm run native:perms",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "serve:dist": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/serve-dist.ts",
    "demo": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/serve-demo.ts",
    "build:ext": "astro build && node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/build-extension.ts",
    "build:ext:firefox": "astro build && node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/build-extension.ts firefox",
    "test:unit": "node --disable-warning=ExperimentalWarning --experimental-strip-types --import ./tests/setup.mjs --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "node --disable-warning=ExperimentalWarning --experimental-strip-types tests/wallet.e2e.ts",
    "test:responsive": "node --disable-warning=ExperimentalWarning --experimental-strip-types tests/responsive.e2e.ts",
    "cap:sync": "astro build && cap sync",
    "cap:android": "astro build && cap sync android && cap open android",
    "cap:ios": "astro build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capgo/capacitor-native-biometric": "^8.6.6",
    "@stellar/stellar-sdk": "^16.2.0",
    "astro": "^7.2.1",
    "bip39": "^3.1.0",
    "buffer": "^6.0.3",
    "country-flag-icons": "^1.6.20",
    "ed25519-hd-key": "^2.0.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "yaml": "^2.9.0",
    "uuid": "^14.0.1"
  }
}

# CosmosPay configuration. Copy to `.env` and adjust. Vite only exposes vars
# prefixed with PUBLIC_ to the browser bundle, so NEVER put secrets in PUBLIC_*.

# --- Client base URLs (shipped to the browser) ---
# DEV: leave these EMPTY. The app then calls same-origin (/api, /v1) and the
# Vite dev proxy (see astro.config.ts) forwards to the targets below — no CORS.
# PROD / NATIVE: set absolute URLs, e.g. https://developers.cosmospay.io
PUBLIC_COSMOS_DEV_PLATFORM_URL=
PUBLIC_COSMOS_GATEWAY_URL=

# Vite dev-proxy targets (Node-side only — NOT shipped to the client bundle).
# Developer-Platform (Astro, provisioning /api/wallet/*) runs on 4321.
COSMOS_DEV_PLATFORM_PROXY=https://dev.cosmospay.lat
# APISIX gateway (payments /v1/*). community-server sits behind it on :3000.
COSMOS_GATEWAY_PROXY=https://api.cosmospay.lat

# --- Shared public access (optional, shipped to the browser) ---
# The API key a wallet uses when its user has NOT created a CosmosPay account, so
# swaps, liquidity, pay links and crash reports work on first run. It buys the
# community plan's commission (1.5%); registering is what lowers it.
#
# NOT a secret, and not treated as one: it ships inside an open-source binary. What
# confines it is server-side — the key carries `role: public`, and the gateway only
# admits that role on endpoints returning no per-consumer rows. Leave these EMPTY and
# the wallet fetches the current key from the platform (/api/public-key), which is
# what makes rotation possible without an app-store release. Set them to pin a
# fallback for builds that may not reach the platform on first launch.
PUBLIC_COSMOS_PUBLIC_KEY_DEV=
PUBLIC_COSMOS_PUBLIC_KEY_PROD=

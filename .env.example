# CosmosPay configuration. Copy to `.env` and adjust.
#
# THIS FILE IS THE SOURCE OF TRUTH for where a build points. Everything below has a
# compiled-in fallback (src/constants/backends.ts) so a fresh clone builds and runs, but
# the fallback is the answer for a build that configured nothing — never the place to
# change an endpoint. Set the variable.
#
# Vite only exposes vars prefixed with PUBLIC_ to the browser bundle, so NEVER put a
# secret in a PUBLIC_* var. Anything without the prefix stays Node-side (the dev proxy).
#
# CI: .github/workflows/{ci,deploy-pages,release-extension,native}.yml export every
# PUBLIC_* var below from repository **Variables** of the same name, so setting one in
# GitHub → Settings → Secrets and variables → Actions → Variables overrides the fallback
# for web, extension, desktop, Android and iOS alike. An unset variable is an empty
# string there, which falls through to the compiled-in default — never to a broken URL.

# --- Client base URLs (shipped to the browser) ---
#
# DEV: leave these EMPTY. The app then calls same-origin (/api, /cosmos-api) and the Vite
# dev proxy (see astro.config.ts) forwards to the targets further down — no CORS.
#
# PROD / NATIVE: set absolute URLs. There is no proxy in an extension popup, a Tauri
# window or a static web deploy, so an empty value there falls back to
# src/constants/backends.ts instead.
#
# Changing PUBLIC_COSMOS_DEV_PLATFORM_URL or PUBLIC_COSMOS_GATEWAY_URL to a host outside
# *.cosmospay.lat is enough: scripts/build-extension.ts derives the MV3 manifest's
# `host_permissions` from these two, which is what exempts the extension from CORS.
PUBLIC_COSMOS_DEV_PLATFORM_URL=
PUBLIC_COSMOS_GATEWAY_URL=

# Gateway entry prefix. APISIX strips it itself before forwarding upstream, so this is
# the part of the path in front of /v1. Empty = `/cosmos-api`.
PUBLIC_COSMOS_GATEWAY_ENTRY=

# --- Shared public access (optional, shipped to the browser) ---
# The API key a wallet uses when its user has NOT created a CosmosPay account, so
# swaps, liquidity, pay links and crash reports work on first run. It buys the
# community plan's commission (1.5%); registering is what lowers it.
#
# NOT a secret, and not treated as one: it ships inside an open-source binary. What
# confines it is server-side — the key carries `role: public`, and the gateway only
# admits that role on endpoints returning no per-consumer rows. Leave these EMPTY and
# the wallet fetches the current key from the platform (/api/public-key), which is
# what makes rotation possible without an app-store release. Set them to pin a
# fallback for builds that may not reach the platform on first launch.
PUBLIC_COSMOS_PUBLIC_KEY_DEV=
PUBLIC_COSMOS_PUBLIC_KEY_PROD=

# --- Vite dev-proxy targets (Node-side only — NOT shipped to the client bundle) ---
# Only used by `astro dev`. The browser hits same-origin /api and /cosmos-api and Vite
# forwards them from Node, which is why the PUBLIC_* pair above stays empty in dev.
# Developer-Platform (Astro, provisioning /api/wallet/*) runs on 4321 locally.
COSMOS_DEV_PLATFORM_PROXY=https://dev.cosmospay.lat
# APISIX gateway (payments /v1/*). community-server sits behind it on :3000.
COSMOS_GATEWAY_PROXY=https://api.cosmospay.lat

# Extra hostnames `astro dev` will answer to, comma-separated. Needed when the dev
# server is reached through a tunnel (Vite refuses an unknown Host header). Empty is
# fine and is the normal case — localhost and LAN addresses never need listing.
ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# WHAT THE BACKENDS MUST ALLOW — not configuration, a checklist for the server
# ---------------------------------------------------------------------------
#
# The wallet ships one bundle into five shells, and each presents a different Origin to
# the dev platform and to the gateway. Nothing in this repo can change what those
# origins are, so both backends' CORS allowlists have to name them:
#
#   web                    the deploy's own origin, plus http://localhost:4500 for dev
#   extension              chrome-extension://<id> / moz-extension://<uuid> — NOT
#                          allowlistable (the id changes per unpacked install), and it
#                          does not need to be: `host_permissions` exempts it, which is
#                          why those are derived from the two PUBLIC_* URLs above
#   Tauri macOS/Linux/iOS  tauri://localhost
#   Tauri Windows/Android  http://tauri.localhost
#   Tauri (requested)      tauri://localhost:3000
#
# That last one is allowlisted on the dev platform today and is kept because it was asked
# for, but be aware Tauri v2 mints its custom-protocol origin WITHOUT a port — a wallet
# window never sends it, so it grants nothing on its own. The two lines above it are the
# ones a real build presents, and `http://tauri.localhost` is currently REFUSED (403) by
# the dev platform, which is every Windows and Android build.
#
# There is no `tauri-plugin-http` in src-tauri/Cargo.toml — deliberately, see CLAUDE.md —
# so every Tauri request goes through the WebView's own fetch and is subject to CORS with
# no exemption of any kind. A Tauri origin missing from the allowlist is a desktop or
# mobile build where swaps, liquidity, KYC and the Pollar bridge all fail at once.

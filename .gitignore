# build output — everything lives under dist/ (web in dist/web, extensions in
# dist/extension[-firefox], release zips in dist/release). Regenerated by
# `npm run build` / `build:ext[:firefox]`, so it never belongs in the repo.
dist/
.astro/
# stray packaged artifacts, in case any are ever produced outside dist/
cosmos-pay-*.zip
*.apk
*.aab

# dependencies
node_modules/

# Tauri build outputs.
#
# `target/` and `Cargo.lock` are the usual Rust pair — the lock IS committed for a binary
# crate, so only the build tree is ignored here.
#
# `gen/schemas` is regenerated from the capability files on every build. `gen/android` and
# `gen/apple` are NOT ignored: Tauri expects them committed, and they carry the manifest and
# Info.plist that scripts/native-permissions.ts patches. Anything hand-edited into them is
# still lost on the next `tauri android init`, which is why the declarations live in that
# script rather than in the generated files.
src-tauri/target/
src-tauri/gen/schemas/

# Left over from the Capacitor era, before the native host moved to src-tauri/. Nothing
# generates or reads it any more and it is safe to delete; ignored rather than committed
# so an absent-minded `git add .` cannot resurrect it into the repo.
/android
/ios

# logs / env
*.log
.env
.env.*
!.env.example

# ephemeral GitHub Release body, generated by git-cliff during the release workflow
RELEASE_NOTES.md

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

extension.crx
extension.pem

.claude/council-cache